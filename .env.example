# The folder holding your worlds - one subfolder per world. This is what the
# world switcher lists, what the app remembers as open across a restart, and
# what to point file sync at. Leave it unset and it defaults to
# Documents\VirtualScreen\worlds (Windows) or ~/.vscreen/worlds, under whichever
# account the process runs as - which is rarely what you want on an appliance.
# VIRTUALSCREEN_WORLDS_ROOT=C:\Users\you\Documents\VirtualScreen\worlds

# Singular, and a different thing: the world to fall back to when none has been
# opened yet. Relative paths resolve against the working directory.
VIRTUALSCREEN_WORLD_ROOT=sample-world

VIRTUALSCREEN_HOST=0.0.0.0
VIRTUALSCREEN_PORT=8000
VIRTUALSCREEN_LAN_MODE=false

# Required for any non-loopback host. start-appliance.ps1 refuses to publish an
# appliance to the network without it, because /screen and the static assets are
# deliberately served with no token at all.
VIRTUALSCREEN_ACCESS_TOKEN=

VIRTUALSCREEN_LANGUAGE=en
VIRTUALSCREEN_LANGUAGE_DIR=lang
